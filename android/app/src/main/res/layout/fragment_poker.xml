<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#035007"
    android:fillViewport="true"
    tools:context=".view.games.poker.PokerFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="25dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="High Roller Poker"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvbalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:shadowColor="#FF000000"
            android:shadowDx="2"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:text="XXXXXXXXXX"
            android:textColor="#EDF0ED"
            android:textSize="20sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="15dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="5">

            <ImageView
                android:id="@+id/ivCard1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/back_dark" />

            <ImageView
                android:id="@+id/ivCard2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/back_dark" />

            <ImageView
                android:id="@+id/ivCard3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/back_dark" />

            <ImageView
                android:id="@+id/ivCard4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/back_dark" />

            <ImageView
                android:id="@+id/ivCard5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/back_dark" />
        </LinearLayout>


        <TextView
            android:id="@+id/tvHandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="2"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="24sp"
            android:textStyle="bold" />


        <androidx.cardview.widget.CardView
            android:id="@+id/betInputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#80000000"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/etbetAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:hint="Ποντάρισμα (FUN)"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:textColor="#FFD700"
                android:textColorHint="#A0A0A0"
                android:textSize="18sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>


        <Button
            android:id="@+id/btnDeal"
            android:layout_width="311dp"
            android:layout_height="wrap_content"
            android:text="DEAL"
            android:layout_marginBottom="30dp"
            android:textSize="24sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvresult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="2"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>