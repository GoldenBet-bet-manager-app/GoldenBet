<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ΚΕΝΤΡΙΚΟΣ ΤΙΤΛΟΣ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:letterSpacing="0.2"
            android:text="@string/stats_main_header"
            android:textColor="?attr/colorSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 1. ΚΑΡΤΑ ΣΥΝΟΛΙΚΟΥ ΚΕΡΔΟΥΣ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="?attr/colorSecondary"
            android:layout_marginBottom="24dp">
            <!-- Χαμηλό elevation για να μη χάσουμε το κόκκινο χρώμα -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="@string/stats_profit_header"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtTotalProfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0 FUN"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ΤΙΤΛΟΣ ΠΑΝΩ ΑΠΟ ΤΑ 4 ΚΟΥΤΙΑ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/stats_performance_indexes_header"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 2. GRID ΜΕ ΤΑ 4 KPIs -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:layout_marginBottom="16dp">

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="6dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="110dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp" app:strokeColor="#33FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="@string/stats_win_rate_header"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/txtWinRateValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#D4AF37" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="6dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="110dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp" app:strokeColor="#33FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="@string/stats_profit_per_attempt_header"
                            android:textAlignment="center"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/txtProfitAttemptValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="?attr/colorSecondary" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="6dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="110dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp" app:strokeColor="#33FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="@string/stats_loss_per_loss"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/txtLossPerLossValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="?attr/colorSecondary" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:padding="6dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="110dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp" app:strokeColor="#33FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="@string/stats_profit_per_win"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/txtProfitPerWinValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="?attr/colorSecondary" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </GridLayout>

        <!-- ΤΙΤΛΟΣ ΠΑΝΩ ΑΠΟ ΤΟ ΚΟΥΤΙ ΜΕ ΤΑ 3 ΣΤΑΤΙΣΤΙΚΑ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/stats_records_header"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 3. ΚΑΡΤΑ ΕΞΤΡΑ ΣΤΑΤΙΣΤΙΚΩΝ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtMostTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_timer"
                    android:drawablePadding="12dp"
                    android:drawableTint="?attr/colorSecondary"
                    android:text="@string/stats_most_time"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMostFun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_money_bag"
                    android:drawablePadding="12dp"
                    android:drawableTint="?attr/colorSecondary"
                    android:text="@string/stats_most_fun"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBiggestWin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_trophy"
                    android:drawablePadding="12dp"
                    android:drawableTint="?attr/colorSecondary"
                    android:text="@string/stats_biggest_win"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. ΕΒΔΟΜΑΔΙΑΙΟ ΓΡΑΦΗΜΑ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.1"
            android:text="@string/stats_weekly_activity_header"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="#22FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/stats_weekly_performance_header"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="8dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barMon" android:layout_width="match_parent" android:layout_height="80dp" android:background="#D4AF37" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barTue" android:layout_width="match_parent" android:layout_height="120dp" android:background="#FFD700" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barWed" android:layout_width="match_parent" android:layout_height="60dp" android:background="#F7E7CE" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barThu" android:layout_width="match_parent" android:layout_height="140dp" android:background="#C5A021" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barFri" android:layout_width="match_parent" android:layout_height="100dp" android:background="#D4AF37" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barSat" android:layout_width="match_parent" android:layout_height="160dp" android:background="#FFD700" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal" android:padding="2dp">
                        <View android:id="@+id/barSun" android:layout_width="match_parent" android:layout_height="90dp" android:background="#C5A021" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="?attr/colorSecondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>